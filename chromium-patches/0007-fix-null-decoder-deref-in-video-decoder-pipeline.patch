--- src.orig/media/gpu/chromeos/video_decoder_pipeline.cc
+++ src/media/gpu/chromeos/video_decoder_pipeline.cc
@@ -863,6 +863,23 @@ void VideoDecoderPipeline::ResetTask(bas
   drop_transcrypted_buffers_ = true;
 #endif  // BUILDFLAG(IS_CHROMEOS)
   need_apply_new_resolution = false;
+  // |decoder_| is null whenever this pipeline outlived a failed
+  // initialization, while |this| stays alive and reachable by the client:
+  //   * Initialize() rejects an invalid config, an encrypted config, or a
+  //     config that is not in the platform's supported list synchronously,
+  //     and never posts InitializeTask(), so |decoder_| is never created;
+  //   * OnInitializeDone() resets |decoder_| when the decoder's own
+  //     Initialize() failed and no fallback produced a replacement.
+  // Neither path calls OnError(), so |has_error_| is not a usable guard, and
+  // media::VideoDecoder does not forbid Reset() after a failed Initialize().
+  // Complete the reset locally instead of dereferencing null: OnResetDone()
+  // touches only null-checked members and always posts |reset_cb| back to the
+  // client sequence, so the client is not left waiting on a callback that
+  // never arrives.
+  if (!decoder_) {
+    OnResetDone(std::move(reset_cb));
+    return;
+  }
   decoder_->Reset(base::BindOnce(&VideoDecoderPipeline::OnResetDone,
                                  decoder_weak_this_, std::move(reset_cb)));
 }
