+// Regression test for FYDE-564: a run can create the on-disk hash tree directory
+// and then fail before the TPM-side tree is reset -- e.g. on a fresh install's
+// first boot, before TPM ownership has been taken. The directory outlives that
+// failure, so keying the reset off its existence alone would skip the reset
+// forever, failing every later operation with PW_ERR_TREE_INVALID and leaving
+// the user unable to register any credential at all.
+TEST_F(PinWeaverManagerImplTest, InsertAfterInterruptedTreeReset) {
+  // Reproduce that half-created state: the directory exists, but the TPM-side
+  // tree was never reset.
+  ASSERT_TRUE(base::CreateDirectory(CredDirPath()));
+  InitLEManager();
+
+  std::map<uint32_t, uint32_t> delay_sched = {
+      {kLEMaxIncorrectAttempt, UINT32_MAX},
+  };
+
+  // The manager must recover by re-issuing the reset, not fail permanently.
+  uint64_t label =
+      pinweaver_manager_
+          ->InsertCredential(std::vector<hwsec::OperationPolicySetting>(),
+                             kLeSecret1, kHeSecret1, kResetSecret1, delay_sched,
+                             /*expiration_delay=*/std::nullopt)
+          .AssertOk()
+          .value();
+
+  auto result = pinweaver_manager_->CheckCredential(label, kLeSecret1);
+  ASSERT_OK(result);
+  EXPECT_EQ(result->he_secret, kHeSecret1);
+}
