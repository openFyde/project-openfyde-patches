 #include <utility>
 
 #include <base/check.h>
+#include <base/files/file_path.h>
+#include <base/files/file_util.h>
 #include <base/functional/bind.h>
 #include <base/hash/sha1.h>
 #include <base/logging.h>
@@ -76,6 +78,39 @@ const char* const kPartitionTypesToHide[] = {
     "2e0a753d-9e48-43b0-8337-b15192cb1b5e",  // Chrome OS reserved
 };
 
+static std::string GetDualBootHostDiskSysPath() {
+  static std::string cached;
+  static bool resolved = false;
+
+  if (resolved) {
+    return cached;
+  }
+
+  std::string cmdline;
+  if (!base::ReadFileToString(base::FilePath("/proc/cmdline"), &cmdline) ||
+      cmdline.find("fydeos_dualboot") == std::string::npos) {
+    resolved = true;  // Not dual-boot mode, never retry.
+    return cached;
+  }
+
+  char partition_dev[PATH_MAX];
+  if (!realpath("/dev/disk/by-label/FYDEOS-DUAL-BOOT", partition_dev)) {
+    // Label symlink not yet available, will retry on next call.
+    return cached;
+  }
+
+  const std::string blk =
+      "/sys/class/block/" + base::FilePath(partition_dev).BaseName().value();
+  char sysfs[PATH_MAX];
+  if (!realpath(blk.c_str(), sysfs)) {
+    return cached;
+  }
+
+  cached = base::FilePath(sysfs).DirName().value();
+  resolved = true;  // Successfully resolved, cache permanently.
+  return cached;
+}
