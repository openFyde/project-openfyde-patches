+bool UdevDevice::IsDualBootHostDisk() const {
+  const std::string host_disk_sys = GetDualBootHostDiskSysPath();
+  if (host_disk_sys.empty()) {
+    return false;
+  }
+
+  const char* const current_sys = dev_->GetSysPath();
+  if (!current_sys) {
+    return false;
+  }
+
+  const std::string current_sys_str(current_sys);
+  return (current_sys_str == host_disk_sys) ||
+         (base::StartsWith(current_sys_str, host_disk_sys + "/",
+                          base::CompareCase::SENSITIVE));
+}
